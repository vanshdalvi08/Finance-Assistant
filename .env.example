# Shared local/deployment reference

# Frontend app URL
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Backend base URL for the frontend package
VITE_API_BASE_URL=http://localhost:3001/api

# API server
PORT=3001
NODE_ENV=development

# Database
# Use the Supabase session pooler URL and URL-encode any special characters in the password.
DATABASE_URL=postgresql://postgres.project-ref:password%23@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# JWT
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Optional local bootstrap admin
ADMIN_EMAIL=admin@yojak.in
ADMIN_PASSWORD=yojak123
ADMIN_NAME=Yojak Admin
ADMIN_PHONE=9999999999

# SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@your-domain.com

# Supabase project
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_AVATARS_BUCKET=yojak-avatars
SUPABASE_STORAGE_EXPENSE_ATTACHMENTS_BUCKET=yojak-expense-attachments

# Optional external monitoring dispatch (platform)
PLATFORM_MONITORING_WEBHOOK_URL=
PLATFORM_MONITORING_WEBHOOK_TOKEN=
PLATFORM_MONITORING_MIN_SEVERITY=error
PLATFORM_MONITORING_ALERT_COOLDOWN_MS=90000
PLATFORM_MONITORING_WEBHOOK_TIMEOUT_MS=6000
PLATFORM_MONITORING_INFO_RETENTION_DAYS=30
PLATFORM_MONITORING_WARNING_RETENTION_DAYS=90
PLATFORM_MONITORING_ERROR_RETENTION_DAYS=180
PLATFORM_AUDIT_RETENTION_DAYS=2555
PLATFORM_AUDIT_PRUNE_ENABLED=false

# Optional backup/recovery posture metadata (platform settings)
PLATFORM_BACKUP_STRATEGY=managed-postgres-pitr
PLATFORM_BACKUP_FREQUENCY=daily + wal/pitr
PLATFORM_BACKUP_RETENTION_DAYS=30
PLATFORM_BACKUP_STORAGE=managed-provider
PLATFORM_RECOVERY_RUNBOOK_URL=/platform/recovery
PLATFORM_LAST_RECOVERY_DRILL_DATE=

# Optional admin MFA enforcement
MFA_ENFORCE=true
MFA_TRUST_DAYS=7
MFA_ISSUER_NAME=Reforix Payroll
